# AI Bug Triage System Environment Configuration

# Application
APP_NAME="AI Bug Triage System"
ENVIRONMENT=development
DEBUG=True
PORT=8001
HOST=127.0.0.1

# Security & JWT Auth
SECRET_KEY=ai-bug-triage-super-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for instant zero-dependency execution.
# For PostgreSQL, set: postgresql://username:password@localhost:5432/bug_triage
DATABASE_URL=sqlite:///./bug_triage.db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# AI Provider Settings
# Options: 'gemini', 'openai', or 'demo'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# When keys are missing or invalid, the system automatically falls back to high-fidelity demo AI analysis
DEMO_AI_ENABLED=true
